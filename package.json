{
  "name": "real-stars",
  "version": "0.2.5",
  "description": "Chrome extension that exposes fake stars on GitHub repos",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "vite build --mode production",
    "build:dev": "vite build --mode development",
    "dev": "vite build --watch --mode development",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "node scripts/pack.mjs",
    "site:build-data": "node site/build-data.mjs",
    "site:fetch-trending": "node scripts/fetch-trending.mjs",
    "site:dev": "cd site && python3 -m http.server 4567",
    "site:deploy": "cd worker && pnpm wrangler pages deploy ../site --project-name=real-stars-hall-of-shame --commit-dirty=true",
    "bench": "tsx scripts/bench-repo.ts",
    "diagnose": "tsx scripts/diagnose-repo.ts",
    "score-trending": "tsx scripts/score-trending.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@playwright/test": "^1.49.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2",
    "eslint": "^9",
    "prettier": "^3.4.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@9.15.0"
}

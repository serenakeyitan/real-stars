# Production build environment.
# These values ship in the Chrome Web Store extension binary.
#
# DO NOT put any secrets here — client_id is public (it's in the manifest
# and in the URL of every OAuth request). The client_secret stays in the
# Cloudflare Worker (see worker/README.md).

VITE_GITHUB_CLIENT_ID=Ov23liLfCB5Kaulza66T
VITE_OAUTH_EXCHANGE_URL=https://real-stars-oauth.peer-claw.workers.dev/exchange
VITE_EXTENSION_NAME=real-stars

# Web Store-assigned extension ID's callback URL is registered on the
# production OAuth app at github.com/settings/applications/.
# (No `key` field for prod — Chrome Web Store assigns the ID.)

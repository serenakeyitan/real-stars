# Development build environment — uses the "real-stars (dev)" OAuth app.
#
# Fill in your own dev OAuth app's client_id below (and deploy your own
# dev worker) — see SETUP.md "Local development OAuth setup".
#
# Until you set up the dev app, this file points at production. That's
# why `pnpm build` (production) currently works but `pnpm build:dev`
# will fail loudly with a clear error if you haven't configured the dev app.
#
# These values are NOT secrets — they ship in the dev build binary.
# The client_secret stays in the dev worker.

VITE_GITHUB_CLIENT_ID=__DEV_CLIENT_ID__
VITE_OAUTH_EXCHANGE_URL=https://real-stars-oauth-dev.serenatan.workers.dev/exchange
VITE_EXTENSION_NAME=real-stars (dev)

# Optional: pin a stable dev extension ID via the manifest "key" field.
# Generate once with `chrome://extensions` → "Pack extension" → use the
# resulting .pem file's PUBLIC KEY (base64-encoded, single line). Pasted
# here, the unpacked install gets the same ID every time you reload.
# Leave empty to let Chrome assign a new ID per install path.
VITE_EXTENSION_KEY=
